{
  "name": "unified-messenger",
  "version": "0.2.11",
  "description": "A Windows workspace for Telegram, WhatsApp, Eitaa, Bale and Rubika",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "test:ui": "node scripts/smoke-ui.js",
    "dist": "electron-builder --win nsis --publish never",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "author": "vsajjadx",
  "engines": { "node": ">=22.12.0" },
  "build": {
    "appId": "com.vsajjadx.unifiedmessenger",
    "productName": "Unified Messenger",
    "artifactName": "Unified-Messenger-${version}-${arch}-Setup.${ext}",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Unified Messenger",
      "deleteAppDataOnUninstall": false
    },
    "npmRebuild": false
  },
  "allowScripts": {
    "electron@45.0.0": true
  }
}
